<%- include('partials/header') %>
<section class="hero shell">
  <div class="hero-copy">
    <p class="eyebrow">Local action, shared purpose</p>
    <h1>Find a way to make your corner of the world stronger.</h1>
    <p class="lede">
      Service Network brings volunteers, organizations, and practical projects
      together so every hour of service can matter.
    </p>
    <div class="button-row">
      <a class="button button-primary" href="/projects">Explore projects</a>
      <a class="button button-secondary" href="/organizations"
        >Meet organizations</a
      >
    </div>
  </div>
  <div class="hero-panel" aria-label="Service network statistics">
    <p class="panel-label">This month</p>
    <strong>128</strong>
    <p>active service opportunities</p>
    <div class="panel-rule"></div>
    <p class="panel-note">Small commitments add up to visible change.</p>
  </div>
  <img
    class="main-logo"
    src="/images/cse340-service-network.png"
    alt="CSE 340 Service Network logo"
  />
</section>
<section class="feature-band">
  <div class="shell feature-grid">
    <article>
      <span class="feature-number">01</span>
      <h2>Choose your cause</h2>
      <p>Browse projects by the issues and communities you care about most.</p>
    </article>
    <article>
      <span class="feature-number">02</span>
      <h2>Show up together</h2>
      <p>Find organizations building trusted teams around real local needs.</p>
    </article>
    <article>
      <span class="feature-number">03</span>
      <h2>Leave a mark</h2>
      <p>Turn a few hours into progress your neighbors can feel and see.</p>
    </article>
  </div>
</section>
<%- include('partials/footer') %>
