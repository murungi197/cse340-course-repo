<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %> | Service Network</title>
    <link rel="stylesheet" href="/css/main.css" />
  </head>
  <body>
    <header class="site-header">
      <div class="shell nav-wrap">
        <a class="brand" href="/" aria-label="Service Network home">
          <span class="brand-mark">SN</span>
          <span>Service Network</span>
        </a>
        <nav aria-label="Primary navigation">
          <a class="<%= page === 'home' ? 'active' : '' %>" href="/">Home</a>
          <a
            class="<%= page === 'organizations' ? 'active' : '' %>"
            href="/organizations"
            >Organizations</a
          >
          <a class="<%= page === 'projects' ? 'active' : '' %>" href="/projects"
            >Projects</a
          >
          <a
            class="<%= page === 'categories' ? 'active' : '' %>"
            href="/categories"
            >Categories</a
          >
        </nav>
      </div>
    </header>
    <main>
      <% const successMessages = flash('success'); %>
      <% const errorMessages = flash('error'); %>
      <% const warningMessages = flash('warning'); %>
      <% if (successMessages.length || errorMessages.length || warningMessages.length) { %>
        <div class="shell flash-messages" role="status" aria-live="polite">
          <% successMessages.forEach((message) => { %>
            <p class="flash flash-success"><%= message %></p>
          <% }) %>
          <% errorMessages.forEach((message) => { %>
            <p class="flash flash-error" role="alert"><%= message %></p>
          <% }) %>
          <% warningMessages.forEach((message) => { %>
            <p class="flash flash-warning"><%= message %></p>
          <% }) %>
        </div>
      <% } %>
  </body>
</html>
