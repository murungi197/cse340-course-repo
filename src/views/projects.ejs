<%- include('partials/header') %>
<section class="page-heading shell">
  <p class="eyebrow">Your next good hour</p>
  <h1>Projects</h1>
  <p class="lede">
    Find a focused opportunity and bring your time, skills, and care to the
    work.
  </p>
</section>
<section class="content-section shell project-list">
  <article class="project-row">
    <div>
      <span class="card-kicker">Bright Future Learning</span>
      <h2>Read with a student</h2>
      <p>Support elementary readers during a weekly literacy session.</p>
    </div>
    <div class="project-meta">
      <span>Weekly</span><span>2 volunteers</span
      ><a class="button button-primary" href="/organizations">Learn more</a>
    </div>
  </article>
  <article class="project-row">
    <div>
      <span class="card-kicker">Green Harvest Collective</span>
      <h2>Harvest the community garden</h2>
      <p>Help gather fresh produce for neighborhood food boxes.</p>
    </div>
    <div class="project-meta">
      <span>Saturday</span><span>8 volunteers</span
      ><a class="button button-primary" href="/organizations">Learn more</a>
    </div>
  </article>
  <article class="project-row">
    <div>
      <span class="card-kicker">UnityServe</span>
      <h2>Refresh a shared space</h2>
      <p>Give a neighborhood park some care before the new season.</p>
    </div>
    <div class="project-meta">
      <span>One day</span><span>12 volunteers</span
      ><a class="button button-primary" href="/organizations">Learn more</a>
    </div>
  </article>
</section>
<%- include('partials/footer') %>
