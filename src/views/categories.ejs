<%- include('partials/header') %>
<section class="page-heading shell">
  <p class="eyebrow">Ways to get involved</p>
  <h1>Categories</h1>
  <p class="lede">
    Browse service projects by the causes and activities that matter most to you.
  </p>
  <a class="button" href="/new-category">Add New Category</a>
</section>
<section class="content-section shell category-grid">
  <% categories.forEach((category) => { %>
    <article class="category-card">
      <h2><a href="/category/<%= category.category_id %>"><%= category.name %></a></h2>
    </article>
  <% }) %>
</section>
<%- include('partials/footer') %>
