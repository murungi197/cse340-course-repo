<%- include('partials/header') %>
<section class="page-heading shell">
  <p class="eyebrow">Service category</p>
  <h1><%= category.name %></h1>
  <p class="lede">Explore service projects connected to this cause.</p>
</section>
<section class="content-section shell project-list">
  <% if (projects.length) { %>
    <% projects.forEach((project) => { %>
      <article class="project-row">
        <h2><a href="/project/<%= project.project_id %>"><%= project.title %></a></h2>
      </article>
    <% }) %>
  <% } else { %>
    <p>No service projects are currently available in this category.</p>
  <% } %>
</section>
<%- include('partials/footer') %>