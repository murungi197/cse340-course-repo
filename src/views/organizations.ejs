<%- include('partials/header') %>
<section class="page-heading shell">
  <p class="eyebrow">The people behind the work</p>
  <h1>Organizations</h1>
  <p class="lede">
    Meet the local groups creating thoughtful ways for volunteers to contribute.
  </p>
</section>
<section class="content-section shell card-grid">
  <% organizations.forEach((organization) => { %>
    <article class="info-card">
      <img src="/images/<%= organization.logo_filename %>" alt="<%= organization.name %> logo" />
      <h2><a href="/organization/<%= organization.organization_id %>"><%= organization.name %></a></h2>
      <p><%= organization.description %></p>
      <a href="/organization/<%= organization.organization_id %>">View organization <span aria-hidden="true">-&gt;</span></a>
    </article>
  <% }) %>
</section>
<%- include('partials/footer') %>
