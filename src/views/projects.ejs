<%- include('partials/header') %>
<section class="page-heading shell">
  <p class="eyebrow">Your next good hour</p>
  <h1>Upcoming Service Projects</h1>
  <p class="lede">
    Find a focused opportunity and bring your time, skills, and care to the
    work.
  </p>
</section>
<section class="content-section shell project-list">
  <% projects.forEach((project) => { %>
    <article class="project-row">
      <div>
        <h2>
          <a href="/project/<%= project.project_id %>">
            <%= project.title %>
          </a>
          <span>
            (<em><a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a></em>)
          </span>
        </h2>
        <p><%= new Intl.DateTimeFormat("en-US", { dateStyle: "long", timeZone: "UTC" }).format(new Date(project.date)) %></p>
        <p><%= project.description %></p>
      </div>
    </article>
  <% }) %>
</section>
<%- include('partials/footer') %>
