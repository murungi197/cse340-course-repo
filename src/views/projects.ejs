<%- include('partials/header') %>
<section class="page-heading shell">
  <p class="eyebrow">Your next good hour</p>
  <h1>Projects</h1>
  <p class="lede">
    Find a focused opportunity and bring your time, skills, and care to the
    work.
  </p>
</section>
<section class="content-section shell project-list">
  <% projects.forEach((project) => { %>
    <article class="project-row">
      <div>
        <h2>
          <%= new Intl.DateTimeFormat("en-US", { dateStyle: "long", timeZone: "UTC" }).format(new Date(project.project_date)) %>:
          <%= project.title %> (<em><%= project.organization_name %></em>)
        </h2>
        <p><%= project.description %></p>
      </div>
    </article>
  <% }) %>
</section>
<%- include('partials/footer') %>
